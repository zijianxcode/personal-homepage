# 腾讯云 CloudBase 环境 ID（在控制台「概览」中查看）
# 复制此文件为 .env 或 .env.local 并填入你的 envId
TCB_ENV_ID=your-env-id

# 云函数会话签名密钥：请使用 32+ 位高熵随机字符串
# APP_SESSION_SECRET=replace-with-a-long-random-secret

# 私信功能 - 管理员密码（云函数环境变量）
# ADMIN_PASSWORD=replace-with-a-long-random-password

# 允许跨域访问云函数的前端来源，多个域名用英文逗号分隔
# ALLOWED_ORIGINS=https://bananabox.plus,https://zijianxcode.github.io

# 受限内容访问码（不要提交到仓库）
# THINGS_PERMIT_CODE=replace-with-a-rotated-code

# 受限内容条目（不要提交到仓库）
# CloudBase 推荐使用 base64: 前缀包裹 JSON 字符串，避免部署时被识别成非 string
# 例如：
# THINGS_CONTENT_JSON=base64:W3sibmFtZSI6IuS4u-mimC3ml7bpl7QgQWJvdXQgVGltZSIsInVybCI6Imh0dHBzOi8vZXhhbXBsZS5jb20veW91ci1wcm90ZWN0ZWQtbGluayJ9XQ==
