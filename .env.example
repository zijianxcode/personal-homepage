# 腾讯云 CloudBase 环境 ID（在控制台「概览」中查看）
# 复制此文件为 .env 或 .env.local 并填入你的 envId
TCB_ENV_ID=your-env-id

# AI Builders Space 部署用（与 Cursor MCP ai-builders-coach 使用的 token 相同）
# AI_BUILDER_TOKEN=sk_xxx

# Supabase 配置（用于访客计数器）
# 在 https://supabase.com 创建免费项目后获取
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
